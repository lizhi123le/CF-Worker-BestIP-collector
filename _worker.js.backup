    <!-- 主题色 -->
    <meta name="theme-color" content="#3b82f6">
    <style>
        :root {
            /* 浅色模式变量 */
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-hover: #f1f5f9;
