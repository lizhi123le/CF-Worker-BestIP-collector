export default {
  async scheduled(event, env, ctx) {
    console.log('Running scheduled IP update...');
    await updateAllIPs(env);
  },

  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname;

    // 必须绑定两个 KV
    if (!env.IP_STORAGE || !env.IP_LOCATION) {
      return new Response('Missing KV binding: IP_STORAGE or IP_LOCATION', { status: 500 });
    }

    if (request.method === 'OPTIONS') return handleCORS();

    try {
      switch (path) {
        case '/':          return await serveHTML(env);
        case '/update':    return request.method === 'POST' ? await handleUpdate(env) : jsonResponse({error:'Method not allowed'},405);
        case '/ips':       return await handleGetIPs(env);          // 纯文本 ip#地区
        case '/ip.txt':    return await handleGetIPs(env);
        case '/raw':       return await handleRawIPs(env);          // JSON，ips 为 ["ip#地区", ...]
        case '/speedtest': return await handleSpeedTest(request, env);
        case '/itdog-data':return await handleItdogData(env);
        default:           return jsonResponse({error:'Not found'},404);
      }
    } catch (e) {
      console.error(e);
      return jsonResponse({error:e.message},500);
    }
  }
};

/* ====================== 地区查询核心 ====================== */
// 将 ip2region.xdb（约 8MB）直接放在 Worker 里（上传为 Asset 或直接 base64 嵌入均可）
const XDB_BUFFER = IP2REGION_XDB;   // ← 你需要在 Worker 编辑器里上传名为 ip2region.xdb 的文件并引用

let searcher = null;
async function getSearcher() {
  if (searcher) return searcher;
  // Cloudflare Worker 全局只创建一次
  searcher = await import('ip2region').then(mod => mod.newSearcher(XDB_BUFFER));
  return searcher;
}

async function getLocation(ip) {
  try {
    const s = await getSearcher();
    const result = await s.search(ip);
    if (result && result.region) {
      // 结果示例：中国|0|广东省|广州市|电信
      const parts = result.region.split('|');
      const arr = [];
      if (parts[0] && parts[0] !== '0') arr.push(parts[0]);
      if (parts[2] && parts[2] !== '0') arr.push(parts[2]);
      if (parts[3] && parts[3] !== '0') arr.push(parts[3]);
      return arr.length ? arr.join('-') : '中国';
    }
  } catch (e) {
    console.error('IP location error', ip, e);
  }
  return '未知地区';
}

// 带缓存的地区查询（KV 缓存 30 天）
async function getLocationCached(env, ip) {
  const cacheKey = `loc:${ip}`;
  let loc = await env.IP_LOCATION.get(cacheKey);
  if (loc) return loc;

  loc = await getLocation(ip);
  await env.IP_LOCATION.put(cacheKey, loc, { expirationTtl: 60*60*24*30 });
  return loc;
}

// 提供HTML页面
/* ====================== 页面渲染（完整版）====================== */
async function serveHTML(env) {
  const data = await getStoredIPsWithLocation(env);

  // 生成带地区的 IP 列表 HTML
  const ipItemsHTML = data.ips && data.ips.length > 0
    ? data.ips.map(item => {
        const [ip, loc = '未知地区'] = item.split('#');
        const safeId = ip.replace(/\./g, '-');
        return `
          <div class="ip-item" data-ip="${ip}">
            <div class="ip-info">
              <span class="ip-address">
                ${ip}
                <span style="color:#64748b;font-size:0.9em;margin-left:8px;">${loc}</span>
              </span>
              <span class="speed-result" id="speed-${safeId}">-</span>
            </div>
            <div class="action-buttons">
              <button class="small-btn" onclick="testSingleIP('${ip}')" id="test-${safeId}">测速</button>
              <button class="small-btn" onclick="copyIP('${ip}#${loc}')">复制</button>
            </div>
          </div>`;
      }).join('')
    : '<p style="text-align: center; color: #64748b; padding: 40px;">暂无 IP 地址数据，请点击更新按钮获取</p>';

  const html = `<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cloudflare IP 收集器</title>
    <style>
        /* 你原来的全部 CSS（保持 100% 不变） */
        ${/* ← 把你之前贴的那一大段 CSS 原封不动粘贴在这里 → */ ''}
        * { margin:0;padding:0;box-sizing:border-box; }
        body {font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;line-height:1.6;background:#f8fafc;color:#334155;min-height:100vh;padding:20px;}
        .container{max-width:1200px;margin:0 auto;}
        .header{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;padding-bottom:20px;border-bottom:1px solid #e2e8f0;}
        .header-content h1{font-size:2.5rem;background:linear-gradient(135deg,#3b82f6 0%,#06b6d4 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px;font-weight:700;}
        .header-content p{color:#64748b;font-size:1.1rem;}
        .social-links{display:flex;gap:15px;}
        .social-link{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:white;border:1px solid #e2e8f0;transition:all .3s ease;box-shadow:0 2px 4px rgba(0,0,0,.05);}
        .social-link:hover{transform:translateY(-2px);box-shadow:0 4px 8px rgba(0,0,0,.1);}
        .social-link.youtube{color:#dc2626;}.social-link.youtube:hover{background:#fef2f2;border-color:#fecaca;}
        .social-link.github{color:#1f2937;}.social-link.telegram{color:#3b82f6;}.social-link.telegram:hover{background:#eff6ff;border-color:#bfdbfe;}
        .card{background:white;border-radius:16px;padding:30px;margin-bottom:24px;border:1px solid #e2e8f0;box-shadow:0 4px 6px rgba(0,0,0,.05);}
        .card h2{font-size:1.5rem;color:#1e40af;margin-bottom:20px;font-weight:600;}
        .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px;}
        .stat{background:#f8fafc;padding:20px;border-radius:12px;text-align:center;border:1px solid #e2e8f0;}
        .stat-value{font-size:2rem;font-weight:700;color:#3b82f6;margin-bottom:8px;}
        .button-group{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:20px;}
        .button{padding:12px 20px;border:none;border-radius:10px;font-weight:600;cursor:pointer;transition:all .3s;background:#3b82f6;color:white;}
        .button:hover{background:#2563eb;transform:translateY(-1px);box-shadow:0 4px 8px rgba(59,130,246,.3);}
        .button-success{background:#10b981;}.button-success:hover{background:#059669;}
