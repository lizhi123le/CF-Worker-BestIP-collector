            --bg-stat: #0f172a;
            --bg-ip-list: #0f172a;
            --bg-source: #0f172a;
            --bg-modal: #1e293b;
            --bg-admin-modal: #1e293b;
            --bg-admin-dropdown: #1e293b;
            --bg-overlay: rgba(0,0,0,0.7);
            --bg-content-overlay: rgba(0,0,0,0.3);
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-heading: #60a5fa;
            --text-heading-h2: #60a5fa;
            --border-primary: #334155;
            --border-secondary: #475569;
            --border-input: #475569;
            --input-bg: #334155;
            --input-text: #ffffff;
            --shadow-sm: 0 2px 4px rgba(0,0,0,0.3);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.3);
            --shadow-lg: 0 8px 16px rgba(0,0,0,0.4);
            --shadow-button: 0 4px 8px rgba(0,0,0,0.3);
            --btn-secondary-bg: #334155;
            --btn-secondary-text: #e2e8f0;
            --btn-secondary-border: #475569;
            --btn-secondary-hover: #475569;
            --spinner-bg: #334155;
            --success-bg: rgba(16, 185, 129, 0.07);
            --success-text: #17f2b4;
            --success-border: #10b981;
            --error-bg: rgba(239, 68, 68, 0.07);
            --error-text: #fca5a5;
            --error-border: #ef4444;
            --speed-fast-bg: #064e3b;
            --speed-fast-text: #6ee7b7;
            --speed-medium-bg: #b16336;
            --speed-medium-text: #fcd34d;
            --speed-slow-bg: #991b1b;
            --speed-slow-text: #ffcece;
            --social-link-bg: #1e293b;
            --youtube-hover: #450a0a;
            --telegram-hover: #172554;
            --progress-bg: #334155;
            --admin-btn-bg: #2563eb;
            --admin-btn-text: #ffffff;
            --admin-dropdown-btn-bg: #dc2626;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            line-height: 1.6; 
            background: var(--bg-primary); 
            color: var(--text-primary); 
            min-height: 100vh; 
            padding: 20px;
            transition: background 0.3s ease, color 0.3s ease;
        }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 1px solid var(--border-primary); position: relative; }
        .header-content h1 { font-size: 2.5rem; background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 8px; font-weight: 700; }
        [data-theme="dark"] .header-content h1 { background: linear-gradient(135deg, #60a5fa 0%, #22d3ee 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .header-content p { color: var(--text-secondary); font-size: 1.1rem; }
        .social-links { display: flex; gap: 15px; }
        .social-link { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: var(--social-link-bg); border: 1px solid var(--border-primary); transition: all 0.3s ease; text-decoration: none; box-shadow: var(--shadow-sm); }
        .social-link:hover { background: var(--bg-hover); transform: translateY(-2px); border-color: var(--border-secondary); box-shadow: var(--shadow-button); }
        .social-link.youtube { color: #dc2626; }
        .social-link.youtube:hover { background: var(--youtube-hover); border-color: #dc2626; }
        .social-link.github { color: #1f2937; }
        [data-theme="dark"] .social-link.github { color: #e2e8f0; }
        .social-link.telegram { color: #3b82f6; display: inline-flex; align-items: center; justify-content: center; }
        .social-link.telegram svg { display: block; transform: translate(-2.8px, -3.6px); }
        .social-link.telegram:hover { background: var(--telegram-hover); border-color: #3b82f6; }
        .admin-button { background: var(--admin-btn-bg); color: var(--admin-btn-text); border: none; padding: 11px 20px; border-radius: 10px 10px 10px 10px; cursor: pointer; font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; position: absolute; right: 0; top: 30%; transform: translateY(-50%); min-width: 122px; max-width: 128px; box-shadow: var(--shadow-sm); transition: all 0.3s ease; z-index: 101; }
        .admin-button:hover { background: #2563eb; }
        .admin-dropdown { display: none; position: absolute; right: 0; top: 100%; margin-top: -72px; background: var(--bg-admin-dropdown); border: 1px solid var(--border-primary); border-top: none; border-radius: 0 0 10px 10px; box-shadow: var(--shadow-lg); z-index: 100; min-width: 121px; max-width: 129px; overflow: hidden; }
        .admin-dropdown button { width: 100%; padding: 11px 20px; border: none; background: var(--admin-dropdown-btn-bg); min-width: 121px; max-width: 129px; color: white; text-align: center; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
        .admin-dropdown button:hover { background: #dc2626;}
        .card { background: var(--bg-card); border-radius: 16px; padding: 30px; margin-bottom: 24px; border: 1px solid var(--border-primary); box-shadow: var(--shadow-md); transition: background 0.3s ease, border-color 0.3s ease; }
        .card h2 { font-size: 1.5rem; color: var(--text-heading-h2); margin-bottom: 20px; font-weight: 600; transition: color 0.3s ease; }
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat { background: var(--bg-stat); padding: 20px; border-radius: 12px; text-align: center; border: 1px solid var(--border-primary); transition: background 0.3s ease, border-color 0.3s ease; }
        .stat-value { font-size: 2rem; font-weight: 700; margin-bottom: 8px; }
        .stat-value.recent { color: #3b82f6; }
        .stat-value.total { color: #10b981; }
        .stat-value.time { color: #6b7280; }
        .button-group { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
        .button { padding: 12px 20px; border: none; border-radius: 10px; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: #3b82f6; color: white; border: 1px solid #3b82f6; }
        .button:hover { background: #2563eb; border-color: #2563eb; transform: translateY(-1px); box-shadow: 0 4px 8px rgba(59,130,246,0.3); }
        .button:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }
        .button-success { background: #10b981; border-color: #10b981; }
        .button-success:hover { background: #059669; border-color: #059669; box-shadow: 0 4px 8px rgba(16,185,129,0.3); }
        .button-warning { background: #f59e0b; border-color: #f59e0b; }
        .button-warning:hover { background: #d97706; border-color: #d97706; box-shadow: 0 4px 8px rgba(245,158,11,0.3); }
        .button-secondary { background: var(--btn-secondary-bg); color: var(--btn-secondary-text); border-color: var(--btn-secondary-border); }
        .button-secondary:hover { background: var(--btn-secondary-hover); border-color: var(--border-secondary); box-shadow: var(--shadow-button); }
        .ip-list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .sources-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .ip-list { background: var(--bg-ip-list); border-radius: 12px; padding: 20px; max-height: 500px; overflow-y: auto; border: 1px solid var(--border-primary); transition: background 0.3s ease, border-color 0.3s ease; }
        /* 自定义滚动条样式 */
        .ip-list::-webkit-scrollbar { width: 8px; }
        .ip-list::-webkit-scrollbar-track { background: var(--bg-secondary); border-radius: 4px; }
        .ip-list::-webkit-scrollbar-thumb { background: var(--border-secondary); border-radius: 4px; }
        .ip-list::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }
        /* ip-limit-input 样式 - 覆盖浏览器默认样式 */
        #ip-limit-input {
            background-color: var(--input-bg) !important;
            color: var(--input-text) !important;
            caret-color: var(--input-text);
        }
        /* 确保所有textarea在深色模式下使用正确的颜色 */
        textarea[id$="-textarea"] {
            background-color: var(--input-bg) !important;
            color: var(--input-text) !important;
            caret-color: var(--input-text);
        }
        /* placeholder文字颜色 */
        #ip-limit-input::placeholder,
        textarea[id$="-textarea"]::placeholder,
        input[type="text"]::placeholder {
            color: var(--text-secondary);
            opacity: 0.7;
        }
        /* 确保所有内联样式的input都使用正确的颜色 */
        input[type="text"][id$="-input"] {
            background-color: var(--input-bg) !important;
            color: var(--input-text) !important;
            caret-color: var(--input-text);
        }
        .ip-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border-primary); transition: background 0.3s ease; }
        .ip-item:hover { background: var(--bg-hover); }
        .ip-item:last-child { border-bottom: none; }
        .ip-info { display: flex; align-items: center; gap: 16px; }
        .ip-address { font-family: 'SF Mono', 'Courier New', monospace; font-weight: 600; min-width: 140px; color: var(--text-primary); word-break: break-all; transition: color 0.3s ease; }
        .speed-result { font-size: 0.85rem; padding: 4px 12px; border-radius: 8px; background: var(--spinner-bg); min-width: 70px; text-align: center; font-weight: 600; transition: background 0.3s ease; }
        .speed-fast { background: var(--speed-fast-bg); color: var(--speed-fast-text); }
        .speed-medium { background: var(--speed-medium-bg); color: var(--speed-medium-text); }
        .speed-slow { background: var(--speed-slow-bg); color: var(--speed-slow-text); }
        .action-buttons { display: flex; gap: 8px; }
        .small-btn { padding: 6px 12px; border-radius: 8px; font-size: 0.8rem; border: 1px solid var(--border-secondary); background: var(--btn-secondary-bg); color: var(--btn-secondary-text); cursor: pointer; transition: all 0.3s ease; }
        .small-btn:hover { background: var(--btn-secondary-hover); border-color: var(--border-secondary); }
        .small-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .loading { display: none; text-align: center; padding: 30px; }
        .spinner { border: 3px solid var(--spinner-bg); border-top: 3px solid #3b82f6; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 16px; transition: border-color 0.3s ease; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .result { margin: 20px 0; padding: 16px 20px; border-radius: 12px; display: none; border-left: 4px solid; }
        .success { background: var(--success-bg); color: var(--success-text); border-left-color: var(--success-border); transition: background 0.3s ease, color 0.3s ease; }
        .error { background: var(--error-bg); color: var(--error-text); border-left-color: var(--error-border); transition: background 0.3s ease, color 0.3s ease; }
        .speed-test-progress { margin: 16px 0; background: var(--progress-bg); border-radius: 8px; height: 8px; overflow: hidden; display: none; transition: background 0.3s ease; }
        .speed-test-progress-bar { background: linear-gradient(90deg, #3b82f6, #06b6d4); height: 100%; width: 0%; transition: width 0.3s ease; }
        .sources { display: grid; gap: 12px; }
        .source { padding: 12px 16px; background: var(--bg-source); border-radius: 8px; border-left: 4px solid #10b981; transition: background 0.3s ease; }
        .source.error { border-left-color: #ef4444; }
        /* 更新结果展示样式 */
        .update-result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0; }
        .update-result-item { padding: 12px; border-radius: 8px; border-left: 4px solid; }
        .update-result-item.info { border-left-color: #3b82f6; background: #91c1ff; }
        .update-result-item.success { border-left-color: #10b981; background: #d1fae5; }
        .update-result-item.warning { border-left-color: #f59e0b; background: #fef3c7; }
        .update-result-item.error { border-left-color: #ef4444; background: #fee2e2; }
        .update-result-item.primary { border-left-color: #0ea5e9; background: #a6dcff; }
        .update-result-item.secondary { border-left-color: #a855f7; background: #f3e8ff; }
        [data-theme="dark"] .update-result-item.info { background: #3253ad; }
        [data-theme="dark"] .update-result-item.success { background: #064e3b; }
        [data-theme="dark"] .update-result-item.warning { background: #a16207; }
        [data-theme="dark"] .update-result-item.error { background: #7f1d1d; }
        [data-theme="dark"] .update-result-item.primary { background: #12608d; }
        [data-theme="dark"] .update-result-item.secondary { background: #581c87; }
        .update-result-label { font-weight: 600; color: var(--text-primary); }
        .update-result-title { margin: 16px 0 12px 0; color: var(--text-heading); font-weight: 600; }
        .footer { text-align: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid var(--border-primary); color: var(--text-secondary); transition: border-color 0.3s ease, color 0.3s ease; }
        .footer-logo { width: 16px; height: 16px; vertical-align: middle; margin-right: 2px; transform: translateY(-2px); }
        .admin-overlay { ${showSetPassword || showLogin ? 'display: flex;' : 'display: none;'} position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-overlay); backdrop-filter: blur(5px); z-index: 9999; justify-content: center; align-items: center; transition: background 0.3s ease; }
        .content-overlay { ${!showAdminButton && (showSetPassword || showLogin) ? 'display: block;' : 'display: none;'} position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-content-overlay); backdrop-filter: blur(12px); z-index: 1; pointer-events: none; transition: background 0.3s ease; }
        .container { ${!showAdminButton && (showSetPassword || showLogin) ? 'filter: blur(8px); pointer-events: none; user-select: none;' : ''} transition: filter 0.3s ease; }
        .admin-modal { background: var(--bg-admin-modal); padding: 40px; border-radius: 16px; max-width: 400px; width: 90%; text-align: center; border: 1px solid var(--border-primary); box-shadow: var(--shadow-md); transition: background 0.3s ease, border-color 0.3s ease; }
        .admin-modal h3 { margin-bottom: 20px; color: var(--text-heading); transition: color 0.3s ease; }
        .admin-modal input { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border-input); background: var(--bg-secondary); color: var(--text-primary); margin-bottom: 16px; font-size: 1rem; transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease; }
        .admin-modal button { padding: 12px 24px; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; margin: 0 8px; }
        .admin-modal .btn-primary { background: #3b82f6; color: white; }
        .admin-modal .btn-secondary { background: var(--btn-secondary-bg); color: var(--btn-secondary-text); border: 1px solid var(--btn-secondary-border); transition: background 0.3s ease, color 0.3s ease; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-overlay); backdrop-filter: blur(5px); z-index: 1000; justify-content: center; align-items: center; transition: background 0.3s ease; }
        .modal-content { background: var(--bg-modal); padding: 30px; border-radius: 16px; max-width: 500px; width: 90%; border: 1px solid var(--border-primary); box-shadow: var(--shadow-md); transition: background 0.3s ease, border-color 0.3s ease; }
        .modal h3 { margin-bottom: 16px; color: var(--text-heading); transition: color 0.3s ease; }
        .modal-buttons { display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; }
        /* 主题切换按钮样式 */
        .theme-toggle { cursor: pointer; border: none; background: var(--social-link-bg); }
        .theme-toggle:hover { background: var(--bg-hover); }
        .theme-toggle #theme-icon { font-size: 1.2rem; display: block; }
        /* 主题下拉菜单样式 */
        .theme-dropdown { display: none; position: absolute; right: 60px; top: 60px; background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: 10px; box-shadow: var(--shadow-lg); z-index: 100; min-width: 140px; overflow: hidden; }
        .theme-dropdown.show { display: block; }
        .theme-dropdown button { width: 100%; padding: 10px 16px; border: none; background: transparent; color: var(--text-primary); text-align: left; cursor: pointer; font-size: 0.9rem; transition: background 0.2s ease; }
        .theme-dropdown button:hover { background: var(--bg-hover); }
        .theme-dropdown button.active { background: var(--bg-hover); font-weight: 600; }
        @media (max-width: 768px) {
            .header { flex-direction: column; gap: 20px; text-align: center; }
            .header-content h1 { font-size: 2rem; }
            .button-group { flex-direction: column; }
            .button { width: 100%; justify-content: center; }
            .ip-item { flex-direction: column; align-items: flex-start; gap: 12px; }
            .ip-info { width: 100%; justify-content: space-between; }
            .action-buttons { width: 100%; justify-content: flex-end; }
            .modal-buttons { flex-direction: column; }
            .admin-dropdown { margin-top: -157px !important; min-width: 121px; }
            .admin-modal { padding: 20px; }
            #ip-limit-input { width: 100% !important; min-width: 298px !important; max-width: none !important; flex: 1; }
            .footer-logo { width: 16px; height: 16px; }
        }
    </style>
</head>
<body class="${showAdminButton ? 'authenticated' : 'unauthenticated'}" data-theme="light">
    ${!showAdminButton && (showSetPassword || showLogin) ? '<div class="content-overlay"></div>' : ''}
    <div class="container">
        <div class="header">
            <div class="header-content">
                <h1 style="display:inline-block; animation: breathe 5s ease-in-out infinite;">
                  <span style="display:inline-block; animation: pulse 5s ease-in-out infinite;">🌐</span> Cloudflare IP/域名 收集器
                </h1>
                <style>
                @keyframes breathe {
                    0%,100% { opacity: 0.7; }
                    50%     { opacity: 1; }
                }
                </style>
                <p>网络加速专家 | 智能测速与优化</p>
            </div>
            <div class="social-links">
                <a href="https://youtu.be/rZl2jz--Oes" target="_blank" title="好软推荐" class="social-link youtube">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.546 12 3.546 12 3.546s-7.505 0-9.377.504A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.504 9.376.504 9.376.504s7.505 0 9.377-.504a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12 9.545 15.568z"/>
                    </svg>
                </a>
                <a href="https://github.com/ethgan/CF-Worker-BestIP-collector" target="_blank" title="GitHub" class="social-link github">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.085 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                </a>
                <a href="https://t.me/yt_hytj" target="_blank" title="Telegram" class="social-link telegram">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="m7.06510669 16.9258959c5.22739451-2.1065178 8.71314291-3.4952633 10.45724521-4.1662364 4.9797665-1.9157646 6.0145193-2.2485535 6.6889567-2.2595423.1483363-.0024169.480005.0315855.6948461.192827.1814076.1361492.23132.3200675.2552048.4491519.0238847.1290844.0536269.4231419.0299841.65291-.2698553 2.6225356-1.4375148 8.986738-2.0315537 11.9240228-.2513602 1.2428753-.7499132 1.5088847-1.2290685 1.5496672-1.0413153.0886298-1.8284257-.4857912-2.8369905-1.0972863-1.5782048-.9568691-2.5327083-1.3984317-4.0646293-2.3321592-1.7703998-1.0790837-.212559-1.583655.7963867-2.5529189.2640459-.2536609 4.7753906-4.3097041 4.755976-4.431706-.0070494-.0442984-.1409018-.481649-.2457499-.5678447-.104848-.0861957-.2595946-.0567202-.3712641-.033278-.1582881.0332286-2.6794907 1.5745492-7.5636077 4.6239616-.715635.4545193-1.3638349.6759763-1.9445998.6643712-.64024672-.0127938-1.87182452-.334829-2.78737602-.6100966-1.11296117-.3376271-1.53748501-.4966332-1.45976769-1.0700283.04048-.2986597.32581586-.610598.8560076-.935815z"/>
                    </svg>
                </a>
                <button class="social-link theme-toggle" onclick="toggleTheme()" title="切换主题" aria-label="切换主题">
                    <span id="theme-icon">🌙</span>
                </button>
            </div>
            ${showAdminButton ? `
            <div class="admin-panel">
                <button class="admin-button" onclick="toggleAdminDropdown()">👤管理员🔽</button>
                <div class="admin-dropdown" id="admin-dropdown">
                    <button onclick="handleLogout()">👤 登 出 ⏏️</button>
                </div>
            </div>
            ` : ''}
        </div>
        <div class="card">
            <h2>📊 系统状态</h2>
            <div class="stats">
                <div class="stat"><div class="stat-value recent" id="recent-count">${data.originalCount || 0}</div><div>最近更新数量</div></div>
                <div class="stat"><div class="stat-value total" id="total-count">${data.totalUniqueIPs.toLocaleString()}</div><div>全部数量</div></div>
                <div class="stat"><div class="stat-value time" id="last-time">${data.lastUpdated ? new Date(data.lastUpdated).toLocaleTimeString() : '从未更新'}</div><div>更新时间</div></div>
            </div>
            <div class="button-group">
                <button class="button" onclick="updateIPs()" id="update-btn">🔄 立即更新</button>
                <a href="${ipsHref}" class="button button-success" download="cloudflare_ips.txt">📥 下载列表</a>
                <a href="${ipTxtHref}" class="button button-secondary" target="_blank">🔗 查看文本</a>
                <button class="button button-warning" onclick="startSpeedTest()" id="speedtest-btn">⚡ 开始测速</button>
                <button class="button" onclick="openPathModal()">⛓️ 设置路径</button>
                <button class="button button-secondary" onclick="refreshData()">🔄 刷新状态</button>
                <input type="number" id="ip-limit-input" min="1" placeholder="IP数量" style="padding: 12px; border-radius: 10px; border: 1px solid var(--border-input); background: var(--input-bg); color: var(--input-text); min-width: 120px; max-width: 158px; font-size: 0.95rem;" value="${data.limit || ''}">
                <button class="button" onclick="setIpLimit()" id="set-limit-btn">⚙️ 设置数量</button>
            </div>
            <div class="loading" id="loading"><div class="spinner"></div><p>正在从多个来源收集 IP/域名 地址，请稍候...</p></div>
            <div class="result" id="result"></div>
        </div>
        <div class="card">
            <div class="ip-list-header">
                <h2>📋 IP/域名 地址列表</h2>
                <div>
                    <button class="small-btn" onclick="copyAllIPs()">📋 复制全部</button>
                    <button class="small-btn" onclick="sortBySpeed()" id="sort-btn">🔽 按速度排序</button>
                </div>
            </div>
            <div class="speed-test-progress" id="speed-test-progress">
                <div class="speed-test-progress-bar" id="speed-test-progress-bar"></div>
            </div>
            <div style="text-align: center; margin: 8px 0; font-size: 0.9rem; color: #64748b;" id="speed-test-status">准备测速...</div>
            <div class="ip-list" id="ip-list">
                ${data.ips && data.ips.length > 0 ? data.ips.map(item => {
                  // 确保 address 存在，使用安全默认值
                  const address = item?.address || 'unknown';
                  // 优化：用 btoa 作为 safeId，避免特殊字符
                  const safeId = simpleHash(address);
                  let typeBadge = '';
				  const parsed = parseAddressWithPort(address);
				  if (parsed.type === 'ipv6') {
					typeBadge = '<span style="background:#10b981; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">IPv6</span>';
				  } else if (parsed.type === 'ipv4') {
					typeBadge = '<span style="background:#3b82f6; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">IPv4</span>';
				  } else if (parsed.type === 'domain') {
					typeBadge = '<span style="background:#f59e0b; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">域名</span>';
				  }
				  // 格式化显示地址 - 只在端口不是443时显示端口
				  let displayAddress = parsed.address;
				  if (parsed.type === 'ipv6') {
					displayAddress = '[' + displayAddress + ']'; 
				  }
				  if (parsed.port !== 443) { // Bug fix: Changed "443" to 443 (number)
					displayAddress += ':' + parsed.port;
				  }
                  // 安全转义所有用户数据
                  const safeDisplayAddress = escapeHtml(displayAddress);
                  const safeLocation = escapeHtml(item?.location || '未知');
                  const safeTypeBadge = typeBadge; // typeBadge是安全的HTML
                  return `
                    <div class="ip-item" data-ip="${escapeHtml(address)}">
                        <div class="ip-info">
                            <span class="ip-address">${safeDisplayAddress}#${safeLocation}${safeTypeBadge}</span>
                            <span class="speed-result" id="speed-${safeId}">${item?.latency ? Math.round(item.latency) + 'ms' : '-'}</span>
                        </div>
                        <div class="action-buttons">
                            <button class="small-btn" onclick="testSingleIP('${escapeHtml(address).replace(/'/g, "\\'")}')" id="test-${safeId}">测速</button>
                            <button class="small-btn" onclick="copyIP('${escapeHtml(displayAddress).replace(/'/g, "\\'")}', '${escapeHtml(item?.location || '未知').replace(/'/g, "\\'")}', ${item?.latency || 'null'})">复制</button>
                        </div>
                    </div>
                  `;
                }).join('') : '<p style="text-align: center; color: #64748b; padding: 40px;">暂无 IP/域名 地址数据，请点击更新按钮获取</p>'}
            </div>
        </div>
          <div class="card">
              <div class="sources-header">
                  <h2>🌍 数据来源状态</h2>
                  <button class="button" onclick="openSourcesModal()">⚙️ 设置来源</button>
                  <button class="button" onclick="openBlacklistModal()">◼️ 黑名单</button>
              </div>
              <div class="sources" id="sources">
                  ${data.sources ? data.sources.map(source => {
    let displayName = source.name;
    try {
      displayName = new URL(source.name).hostname;
    } catch (_) {}
    return `
      <div class="source ${source.status === 'success' ? '' : 'error'}">
          <strong>${escapeHtml(displayName)}</strong>:
          ${source.status === 'success' ? '成功获取 ' + (source.count || 0) + ' 个地址' : '失败: ' + escapeHtml(source.error || '未知')}
      </div>
    `;
  }).join('') : '<p style="color: #64748b;">暂无数据来源信息</p>'}
              </div>
          </div>
		<div class="footer">
			<p>
				<img src="/favicon.png" class="footer-logo" title="logo" />
				Cloudflare IP/域名 Collector © ${new Date().getFullYear()} | 增强版
			</p>
		</div>
    </div>
    ${showSetPassword ? `
    <div class="admin-overlay" id="admin-overlay">
        <div class="admin-modal">
            <h3>🔐 设置管理员密码</h3>
            <p>首次使用，请设置管理员密码以保护页面。</p>
            <input type="password" id="set-password-input" placeholder="输入密码（至少4位）">
            <div>
                <button class="btn-secondary" onclick="closeAdminOverlay()">取消</button>
                <button class="btn-primary" onclick="setAdminPassword()">设置密码</button>
            </div>
        </div>
    </div>
    ` : ''}
    ${showLogin ? `
    <div class="admin-overlay" id="admin-overlay">
        <div class="admin-modal">
            <h3>🔐 管理员登录</h3>
            <p>请输入管理员密码以访问页面。</p>
            <input type="password" id="login-password-input" placeholder="输入密码">
            <div>
                <button class="btn-primary" onclick="loginAdmin()">登录</button>
            </div>
        </div>
    </div>
    ` : ''}
    <div class="modal" id="path-modal">
        <div class="modal-content">
            <h3>⛓️ 设置路径</h3>
            <p>输入路径，如 */*/*，保存后下载和查看链接将使用此路径。</p>
            <input type="text" id="path-input" placeholder="e.g. */*/*" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border-input); background: var(--input-bg); color: var(--input-text); margin-bottom: 16px;">
            <div class="modal-buttons">
                <button class="button button-secondary" onclick="closePathModal()">取消</button>
                <button class="button button-success" onclick="savePath()">保存</button>
            </div>
        </div>
    </div>
    <div class="modal" id="sources-modal">
        <div class="modal-content">
            <h3>⚙️ 设置数据来源</h3>
            <p>编辑来源 URL，每行一个。保存后将使用这些来源更新 IP/域名。</p>
            <textarea id="sources-textarea" rows="10" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border-input); background: var(--input-bg); color: var(--input-text);">${(data.sources_urls || []).join('\\n')}</textarea>
            <div class="modal-buttons">
                <button class="button button-secondary" onclick="closeSourcesModal()">取消</button>
                <button class="button button-success" onclick="saveSources()">保存</button>
            </div>
        </div>
    </div>
    <div class="modal" id="blacklist-modal">
        <div class="modal-content">
            <h3>◼️ 黑名单管理</h3>
            <p>输入需要排除的 IPv4/IPv6/域名 地址，每行一个。保存后将在所有页面中过滤这些地址。</p>
            <p><strong>增强功能：</strong> 用双引号包围域名（如 "example.com"）将过滤所有该域名的子域名（如 sub.example.com）。</p>
            <textarea id="blacklist-textarea" rows="10" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border-input); background: var(--input-bg); color: var(--input-text);">${data.blacklist.join('\\n')}</textarea>
            <div class="modal-buttons">
                <button class="button button-secondary" onclick="closeBlacklistModal()">取消</button>
                <button class="button button-success" onclick="saveBlacklist()">保存</button>
            </div>
        </div>
    </div>
    <script>
        // ==================== 主题管理 ====================
        const ThemeManager = {
            STORAGE_KEY: 'cf-ip-collector-theme',
            currentTheme: 'light',
            init() {
                const savedTheme = localStorage.getItem(this.STORAGE_KEY);
                const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme) {
                    this.currentTheme = savedTheme;
                } else {
                    this.currentTheme = systemPrefersDark ? 'dark' : 'light';
                }
                this.applyTheme(this.currentTheme);
                this.updateThemeIcon();
                // 监听系统主题变化
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                    if (!localStorage.getItem(this.STORAGE_KEY)) {
                        this.currentTheme = e.matches ? 'dark' : 'light';
                        this.applyTheme(this.currentTheme);
                        this.updateThemeIcon();
                    }
                });
            },
            applyTheme(theme) {
                document.body.setAttribute('data-theme', theme);
                this.currentTheme = theme;
                // 更新 meta theme-color
                const themeColor = theme === 'dark' ? '#0f172a' : '#3b82f6';
                document.querySelector('meta[name="theme-color"]').setAttribute('content', themeColor);
            },
            toggle() {
                const themes = ['light', 'dark', 'system'];
                const currentIndex = themes.indexOf(this.currentTheme);
                const nextIndex = (currentIndex + 1) % themes.length;
                const nextTheme = themes[nextIndex];
                if (nextTheme === 'system') {
                    localStorage.removeItem(this.STORAGE_KEY);
                    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    this.applyTheme(systemPrefersDark ? 'dark' : 'light');
                } else {
                    localStorage.setItem(this.STORAGE_KEY, nextTheme);
                    this.applyTheme(nextTheme);
                }
                this.currentTheme = nextTheme;
                this.updateThemeIcon();
                // 显示提示
                this.showThemeNotification(nextTheme);
            },
            updateThemeIcon() {
                const icon = document.getElementById('theme-icon');
                if (!icon) return;
                const icons = {
                    'light': '☀️',
                    'dark': '🌙',
                    'system': '💻'
                };
                // 如果是system，根据当前实际显示的主题显示对应图标
                let displayTheme = this.currentTheme;
                if (displayTheme === 'system') {
                    displayTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                icon.textContent = icons[displayTheme];
            },
            showThemeNotification(theme) {
                const messages = {
                    'light': '已切换到浅色模式 ☀️',
                    'dark': '已切换到深色模式 🌙',
                    'system': '已切换到系统模式 💻'
                };
                // 创建临时通知
                const notification = document.createElement('div');
                notification.style.cssText = [
                    'position: fixed',
                    'top: 20px',
                    'right: 20px',
                    'background: var(--bg-card)',
                    'color: var(--text-primary)',
                    'padding: 12px 20px',
                    'border-radius: 8px',
                    'box-shadow: var(--shadow-lg)',
                    'border: 1px solid var(--border-primary)',
                    'z-index: 10000',
                    'font-size: 0.9rem',
                    'animation: slideIn 0.3s ease'
                ].join(';') + ';';
                notification.textContent = messages[theme];
                // 添加动画样式
                if (!document.getElementById('theme-notification-style')) {
                    const style = document.createElement('style');
                    style.id = 'theme-notification-style';
                    style.textContent = '@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }';
                    document.head.appendChild(style);
                }
                document.body.appendChild(notification);
                // 3秒后移除
                setTimeout(() => {
                    notification.style.animation = 'slideIn 0.3s ease reverse';
                    setTimeout(() => notification.remove(), 300);
                }, 2000);
            }
        };
        // 页面加载时初始化主题
        document.addEventListener('DOMContentLoaded', () => {
            ThemeManager.init();
        });
        // 主题切换函数（供按钮调用）
        function toggleTheme() {
            ThemeManager.toggle();
        }
        // HTML转义函数（客户端版本）
        function escapeHtml(text) {
          if (text === null || text === undefined) return '';
          return text.toString()
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }
        function simpleHash(str) {
          if (!str) return '';
          let hash = 0;
          for (let i = 0; i < str.length; i++) {
            hash = (hash * 31 + str.charCodeAt(i)) | 0;
          }
          return (hash >>> 0).toString(36);
        }
        // 管理员相关
        function toggleAdminDropdown() {
            const dropdown = document.getElementById('admin-dropdown');
            if (dropdown) dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        }
        async function setAdminPassword() {
            const input = document.getElementById('set-password-input');
            if (!input || input.value.length < 4) return alert('密码至少4位');
            try {
                const response = await fetch('/admin-set-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: input.value })
                });
                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('设置失败: ' + (data.error || '未知错误'));
                }
            } catch (error) {
                alert('设置失败: ' + error.message);
            }
        }
        async function loginAdmin() {
            const input = document.getElementById('login-password-input');
            if (!input || !input.value) {
                alert('请输入密码');
                return;
            }
            try {
                const response = await fetch('/admin-login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: input.value })
                });
                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('登录失败: ' + (data.error || '未知错误'));
                    // 清空密码输入框
                    if (input) input.value = '';
                    // 确保模糊效果保持
                    ensureBlurEffect();
                }
            } catch (error) {
                alert('登录失败: ' + error.message);
                // 清空密码输入框
                if (input) input.value = '';
                // 确保模糊效果保持
                ensureBlurEffect();
            }
        }
        function ensureBlurEffect() {
            const container = document.querySelector('.container');
            const contentOverlay = document.querySelector('.content-overlay');
            if (container && !document.body.classList.contains('authenticated')) {
                container.style.filter = 'blur(8px)';
                container.style.pointerEvents = 'none';
                container.style.userSelect = 'none';
            }
            if (contentOverlay && !document.body.classList.contains('authenticated')) {
                contentOverlay.style.display = 'block';
            }
        }
        // 页面加载时确保安全状态
        document.addEventListener('DOMContentLoaded', function() {
            if (!document.body.classList.contains('authenticated')) {
                // 禁用所有交互元素
                const interactiveElements = document.querySelectorAll('button, a, input, select, textarea');
                interactiveElements.forEach(el => {
                    if (el.id !== 'login-password-input' && !el.onclick?.toString().includes('loginAdmin')) {
                        el.style.pointerEvents = 'none';
                        el.style.opacity = '0.5';
                    }
                });
                ensureBlurEffect();
            }
        });
        // 防止通过开发者工具移除模糊效果
        (function() {
            let blurCheckInterval;
            function checkBlurStatus() {
                if (!document.body.classList.contains('authenticated')) {
                    const container = document.querySelector('.container');
                    const contentOverlay = document.querySelector('.content-overlay');
                    if (container && (!container.style.filter || container.style.filter === 'none')) {
                        container.style.filter = 'blur(8px)';
                        container.style.pointerEvents = 'none';
                        container.style.userSelect = 'none';
                    }
                    if (contentOverlay && contentOverlay.style.display === 'none') {
                        contentOverlay.style.display = 'block';
                    }
                }
            }
            if (!document.body.classList.contains('authenticated')) {
                blurCheckInterval = setInterval(checkBlurStatus, 1000);
            }
        })();
        function closeAdminOverlay() {
            const overlay = document.getElementById('admin-overlay');
            if (overlay) overlay.style.display = 'none';
        }
        async function handleLogout() {
            try {
                await fetch('/admin-logout', { method: 'POST' });
                location.reload();
            } catch (error) {
                alert('登出失败: ' + error.message);
            }
        }
        // 解析地址类型
        function isValidIPv4(ip) {
            if (!ip || typeof ip !== 'string') return false;
            const octets = ip.split('.');
            if (octets.length !== 4) return false;
            return octets.every(oct => {
                const num = parseInt(oct, 10);
                return !isNaN(num) && num >= 0 && num <= 255 && String(num) === oct;
            });
        }
        // 解析地址类型
        function parseAddressWithPort(address) {
            if (!address || typeof address !== 'string') return { address: '', port: 443, type: 'unknown' };
            // 关键：先剥离可能存在的 # 备注或后缀，再进行解析
            let pure = address.split('#')[0].trim();
            if (pure.startsWith('[') && pure.includes(']')) {
                const bracketEnd = pure.lastIndexOf(']');
                const addr = pure.slice(1, bracketEnd);
                const afterBracket = pure.slice(bracketEnd + 1);
                const portMatch = afterBracket.match(/^:(\d+)$/);
                const port = portMatch ? parseInt(portMatch[1], 10) : 443;
                return { address: addr, port, type: 'ipv6' };
            }
            if ((pure.match(/:/g) || []).length > 1 && !pure.includes('.')) {
                return { address: pure, port: 443, type: 'ipv6' };
            }
            if (pure.includes(':')) {
                const parts = pure.split(':');
                const portStr = parts.pop();
                const addr = parts.join(':');
                const port = parseInt(portStr, 10);
                const type = isValidIPv4(addr) ? 'ipv4' : 'domain';
                return { address: addr, port: isNaN(port) ? 443 : port, type };
            }
            const type = isValidIPv4(pure) ? 'ipv4' : 'domain';
            return { address: pure, port: 443, type };
        }
        // 格式化地址输出
        function formatAddressOutput(address, location, latency) {
          if (!address) return '';
          const parsed = parseAddressWithPort(address);
          const portPart = parsed.port !== "443" ? ':' + parsed.port : "";
          const latencyPart = latency ? Math.round(latency) + 'ms' : "";
          let displayLocation = location || "未知";
          if (parsed.type !== 'domain' && (displayLocation === "未知" || displayLocation.toLowerCase() === 'ipv4' || displayLocation.toLowerCase() === 'ipv6')) {
            displayLocation = parsed.type.toUpperCase();
          }
          if (parsed.type === 'ipv6') {
            return '[' + parsed.address + ']' + portPart + '#' + displayLocation + (latencyPart ? '_' + latencyPart : '');
          } else if (parsed.type === 'domain') {
            return parsed.address + portPart + '#' + (displayLocation && displayLocation !== "未知" ? displayLocation : parsed.address) + (latencyPart ? '_' + latencyPart : '');
          } else {
            // IPv4
            return parsed.address + portPart + '#' + displayLocation + (latencyPart ? '_' + latencyPart : '');
          }
        }
        let speedResults = {};
        let isTesting = false;
        let currentTestIndex = 0;
        let currentSourcesUrls = ${JSON.stringify(data.sources_urls || []).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')};
        let currentBlacklist = ${JSON.stringify(data.blacklist || []).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')};
        let currentPath = '${data.customPath}';
        function showMessage(message, type) {
            if (type === undefined) type = 'success';
            const result = document.getElementById('result');
            if (!result) return;
            result.className = 'result ' + type;
            result.innerHTML = '<p>' + escapeHtml(message) + '</p>';
            result.style.display = 'block';
            setTimeout(function() {
                result.style.display = 'none';
            }, 3000);
        }
        function updateLinks() {
            const pathPart = currentPath ? '/' + currentPath : '';
            const downloadLink = document.querySelector('a[href*="/ips"]');
            const viewLink = document.querySelector('a[href*="/ip.txt"]');
            if (downloadLink) {
                downloadLink.href = pathPart + '/ips';
            }
            if (viewLink) {
                viewLink.href = pathPart + '/ip.txt';
            }
        }
        function openPathModal() {
            const modal = document.getElementById('path-modal');
            const input = document.getElementById('path-input');
            if (!modal || !input) return;
            input.value = currentPath;
            modal.style.display = 'flex';
        }
        function closePathModal() {
            const modal = document.getElementById('path-modal');
            if (modal) modal.style.display = 'none';
        }
        async function savePath() {
            const input = document.getElementById('path-input');
            if (!input) return;
            const path = input.value.trim();
            try {
                const response = await fetch('/set-path', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ path })
                });
                const data = await response.json();
                if (data.success) {
                    currentPath = data.path;  // 使用返回的路径（可能已清洗）
                    showMessage(data.message || '路径设置成功');
                    closePathModal();
                    updateLinks();
                    await refreshData();
                } else {
                    // 显示错误信息，提示用户路径未被修改
                    showMessage(data.error || '设置失败', 'error');
                }
            } catch (error) {
                console.error('保存路径失败:', error);
                showMessage('设置失败: ' + error.message, 'error');
            }
        }
        function copyIP(address, location, latency) {
            let text = formatAddressOutput(address, location, latency);
            navigator.clipboard.writeText(text).then(function() {
                showMessage('已复制 地址: ' + text);
            }).catch(function(err) {
                console.error('复制失败:', err);
                showMessage('复制失败', 'error');
            });
        }
        function copyAllIPs() {
            const ipItems = document.querySelectorAll('.ip-item');
            if (!ipItems.length) return showMessage('没有可复制的地址', 'error');
            const texts = Array.from(ipItems).map(function(item) {
                const address = item.dataset.ip;
                const locationElement = item.querySelector('.ip-address');
                const location = locationElement ? locationElement.textContent.split('#')[1].split('_')[0] : '未知';
                const latencyStr = item.querySelector('.speed-result').textContent;
                const latency = latencyStr.includes('ms') ? parseInt(latencyStr) : null;
                return formatAddressOutput(address, location, latency);
            });
            const allText = texts.join('\\n');
            navigator.clipboard.writeText(allText).then(function() {
                showMessage('已复制 ' + ipItems.length + ' 个地址');
            }).catch(function(err) {
                console.error('复制全部失败:', err);
                showMessage('复制失败', 'error');
            });
        }
        async function testSingleIP(address) {
            const item = document.querySelector('[data-ip="' + CSS.escape(address) + '"]');
            if (!item) return showMessage('未找到地址元素', 'error');
            const testBtn = item.querySelector('.small-btn[id^="test-"]');
            const speedElement = item.querySelector('.speed-result');
            const addressElement = item.querySelector('.ip-address');
            if (!addressElement) return;
            // 关键：从当前文本里提取类型角标（纯文本版）
            let typeBadgeText = '';
            if (addressElement.textContent.includes('IPv6')) typeBadgeText = 'IPv6';
            else if (addressElement.textContent.includes('IPv4')) typeBadgeText = 'IPv4';
            else if (addressElement.textContent.includes('域名')) typeBadgeText = '域名';
            // 根据类型生成完整的带样式的角标 HTML
            let typeBadge = '';
            if (typeBadgeText === 'IPv6') {
                typeBadge = '<span style="background:#10b981;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">IPv6</span>';
            } else if (typeBadgeText === 'IPv4') {
                typeBadge = '<span style="background:#3b82f6;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">IPv4</span>';
            } else if (typeBadgeText === '域名') {
                typeBadge = '<span style="background:#f59e0b;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">域名</span>';
            }
            if (!testBtn || !speedElement || !addressElement) return showMessage('元素缺失，无法测速', 'error');
            testBtn.disabled = true;
            testBtn.textContent = '测试中...';
            speedElement.textContent = '测试中...';
            speedElement.className = 'speed-result';
            try {
                const startTime = performance.now();
                const response = await fetch('/speedtest?ip=' + encodeURIComponent(address));
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();
                const latency = performance.now() - startTime;
                speedResults[address] = { latency: latency, success: data.success };
                if (data.success) {
                    const rounded = Math.round(latency);
                    const speedClass = rounded < 200 ? 'speed-fast' : rounded < 500 ? 'speed-medium' : 'speed-slow';
                    speedElement.textContent = rounded + 'ms';
                    speedElement.className = 'speed-result ' + speedClass;
                    // 安全地更新地址元素文本
                    const parsed = parseAddressWithPort(address);
                    let displayLocation = data.location || '未知';
                    if (parsed.type !== 'domain' && (displayLocation === "未知" || displayLocation.toLowerCase() === 'ipv4' || displayLocation.toLowerCase() === 'ipv6')) {
                      displayLocation = parsed.type.toUpperCase();
                    }
                    // 对于域名类型：如果 displayLocation 是域名本身（无国家代码），则使用域名作为兜底
                    if (parsed.type === 'domain') {
                      // 检查 location 是否包含国家代码（格式：domain_CN）
                      const hasCountryCode = displayLocation && displayLocation !== "未知" && displayLocation.startsWith(parsed.address + '_');
                      if (hasCountryCode) {
                        displayLocation = displayLocation; // 保留完整的 domain_CN
                      } else {
                        // 查询失败或无有效位置，使用域名本身作为兜底
                        displayLocation = parsed.address;
                      }
                    }
                    const baseText = addressElement.textContent.split('#')[0] + '#' + displayLocation;
                    addressElement.innerHTML = baseText + (rounded ? '_' + rounded + 'ms' : '') + typeBadge;
                    showMessage('地址 ' + address + ' 测速完成: ' + rounded + 'ms');
                } else {
                    speedElement.textContent = '失败';
                    speedElement.className = 'speed-result speed-slow';
                }
            } catch (error) {
                console.error('测速错误:', error);
                speedElement.textContent = '错误';
                speedElement.className = 'speed-result speed-slow';
                showMessage('地址 ' + address + ' 测速错误: ' + error.message, 'error');
            } finally {
                testBtn.disabled = false;
                testBtn.textContent = '测速';
                // 强制重绘
                void speedElement.offsetHeight;
            }
        }
        async function startSpeedTest() {
            if (isTesting) return showMessage('测速正在进行中，请稍候...', 'error');
            const ipItems = Array.from(document.querySelectorAll('.ip-item'));
            if (ipItems.length === 0) return showMessage('没有可测速的地址', 'error');
            const speedtestBtn = document.getElementById('speedtest-btn');
            const progressBar = document.getElementById('speed-test-progress');
            const progressBarInner = document.getElementById('speed-test-progress-bar');
            const statusElement = document.getElementById('speed-test-status');
            isTesting = true;
            speedtestBtn.disabled = true;
            speedtestBtn.textContent = '测速中...';
            progressBar.style.display = 'block';
            const totalIPs = ipItems.length;
            currentTestIndex = 0;
            // 重置所有速度结果显示
            document.querySelectorAll('.speed-result').forEach(function(el) {
                el.textContent = '测试中...';
                el.className = 'speed-result';
            });
            // 禁用所有测速按钮
            document.querySelectorAll('.small-btn[id^="test-"]').forEach(function(btn) {
                if (btn) btn.disabled = true;
            });
            for (let i = 0; i < totalIPs; i++) {
                const ipItem = ipItems[i];
                const address = ipItem.dataset.ip;
                if (!address) continue;
                statusElement.textContent = '正在测速 ' + (i+1) + '/' + totalIPs + ': ' + address;
                const startTime = performance.now();
                try {
                    const response = await fetch('/speedtest?ip=' + encodeURIComponent(address));
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    const data = await response.json();
                    const latency = performance.now() - startTime;
                    const speedElement = ipItem.querySelector('.speed-result');
                    const addressElement = ipItem.querySelector('.ip-address');
                    if (!addressElement) return;
                    // 关键：从当前文本里提取类型角标（纯文本版）
                    let typeBadgeText = '';
                    if (addressElement.textContent.includes('IPv6')) typeBadgeText = 'IPv6';
                    else if (addressElement.textContent.includes('IPv4')) typeBadgeText = 'IPv4';
                    else if (addressElement.textContent.includes('域名')) typeBadgeText = '域名';
                    // 根据类型生成完整的带样式的角标 HTML
                    let typeBadge = '';
                    if (typeBadgeText === 'IPv6') {
                        typeBadge = '<span style="background:#10b981;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">IPv6</span>';
                    } else if (typeBadgeText === 'IPv4') {
                        typeBadge = '<span style="background:#3b82f6;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">IPv4</span>';
                    } else if (typeBadgeText === '域名') {
                        typeBadge = '<span style="background:#f59e0b;color:white;padding:2px 6px;border-radius:4px;font-size:0.8rem;margin-left:8px;">域名</span>';
                    }
                    if (data.success) {
                        const rounded = Math.round(latency);
                        const speedClass = rounded < 200 ? 'speed-fast' : rounded < 500 ? 'speed-medium' : 'speed-slow';
                        if (speedElement) {
                            speedElement.textContent = rounded + 'ms';
                            speedElement.className = 'speed-result ' + speedClass;
                        }
                        if (addressElement) {
                            const parsed = parseAddressWithPort(address);
                            let displayLocation = data.location || '未知';
                            if (parsed.type !== 'domain' && (displayLocation === "未知" || displayLocation.toLowerCase() === 'ipv4' || displayLocation.toLowerCase() === 'ipv6')) {
                              displayLocation = parsed.type.toUpperCase();
                            }
                            // 对于域名类型：如果 displayLocation 是域名本身（无国家代码），则使用域名作为兜底
                            if (parsed.type === 'domain') {
                              // 检查 location 是否包含国家代码（格式：domain_CN）
                              const hasCountryCode = displayLocation && displayLocation !== "未知" && displayLocation.startsWith(parsed.address + '_');
                              if (hasCountryCode) {
                                displayLocation = displayLocation; // 保留完整的 domain_CN
                              } else {
                                // 查询失败或无有效位置，使用域名本身作为兜底
                                displayLocation = parsed.address;
                              }
                            }
                            const baseText = addressElement.textContent.split('#')[0] + '#' + displayLocation;
                            addressElement.innerHTML = baseText + (rounded ? '_' + rounded + 'ms' : '') + typeBadge;
                        }
                        speedResults[address] = { latency: rounded, success: true };
                    } else {
                        if (speedElement) {
                            speedElement.textContent = '失败';
                            speedElement.className = 'speed-result speed-slow';
                        }
                    }
                    // 强制重绘
                    if (speedElement) void speedElement.offsetHeight;
                } catch (error) {
                    console.error('批量测速错误:', error);
                    const speedElement = ipItem.querySelector('.speed-result');
                    if (speedElement) {
                        speedElement.textContent = '错误';
                        speedElement.className = 'speed-result speed-slow';
                    }
                }
                currentTestIndex = i + 1;
                progressBarInner.style.width = (currentTestIndex / totalIPs) * 100 + '%';
                // 添加延迟，避免对服务器造成过大压力
                await new Promise(function(r) { setTimeout(r, 700 / Math.max(totalIPs, 4)); });
            }
            isTesting = false;
            speedtestBtn.disabled = false;
            speedtestBtn.textContent = '⚡ 开始测速';
            progressBar.style.display = 'none';
            // 重新启用所有测速按钮
            document.querySelectorAll('.small-btn[id^="test-"]').forEach(function(btn) {
                if (btn) btn.disabled = false;
            });
            sortBySpeed();
            showMessage('测速完成，已测试 ' + currentTestIndex + ' 个地址，已按延迟排序');
        }
        function sortBySpeed() {
            const ipList = document.getElementById('ip-list');
            if (!ipList) return;
            const ipItems = Array.from(ipList.querySelectorAll('.ip-item'));
            ipItems.sort(function(a, b) {
              const ra = speedResults[a.dataset.ip];
              const rb = speedResults[b.dataset.ip];
              // 修复排序逻辑：基于实际速度值而不是数据存在性
              if (ra && rb && ra.success && rb.success) {
                return ra.latency - rb.latency;
              }
              if (ra && ra.success) {
                return rb && rb.success ? 1 : -1;
              }
              if (rb && rb.success) {
                return ra && ra.success ? -1 : 1;
              }
              return 0;
            });
            // 重新添加排序后的元素
            ipItems.forEach(function(item) {
              if (item && ipList) ipList.appendChild(item);
            });
        }
        // 替换原有的 updateIPs 函数（修复版本）
        async function updateIPs() {
            const btn = document.getElementById('update-btn');
            const loading = document.getElementById('loading');
            const result = document.getElementById('result');
            if (!btn || !loading || !result) return;
            btn.disabled = true;
            loading.style.display = 'block';
            result.style.display = 'none';
            try {
                const response = await fetch('/update', { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    // 构建你要求的两列布局格式
                    let resultHtml = '<h3>✅ 更新成功！</h3>';
                    // 创建两列布局容器
                    resultHtml += '<div class="update-result-grid">';
                    // 左列
                    resultHtml += '<div style="display: flex; flex-direction: column; gap: 8px;">';
                    resultHtml += '<div class="update-result-item info">';
                    resultHtml += '<div class="update-result-label">⏱️ 耗时：' + escapeHtml(data.duration) + '</div>';
                    resultHtml += '</div>';
                    resultHtml += '<div class="update-result-item success">';
                    resultHtml += '<div class="update-result-label">🌐 总地址数：' + escapeHtml(data.totalIPs) + '</div>';
                    resultHtml += '</div>';
                    resultHtml += '<div class="update-result-item warning">';
                    resultHtml += '<div class="update-result-label">📍 新位置测试：' + escapeHtml(data.newLocationTested) + '</div>';
                    resultHtml += '</div>';
                    resultHtml += '<div class="update-result-item primary">';
                    resultHtml += '<div class="update-result-label">⚡ 新延迟测试：' + escapeHtml(data.newLatencyTested) + '</div>';
                    resultHtml += '</div>';
                    resultHtml += '</div>';
                    // 右列
                    resultHtml += '<div style="display: flex; flex-direction: column; gap: 8px;">';
                    if (data.locationFailedCount !== undefined) {
                        resultHtml += '<div class="update-result-item error">';
                        resultHtml += '<div class="update-result-label">❌ 位置失败数量：' + escapeHtml(data.locationFailedCount) + '</div>';
                        resultHtml += '</div>';
                    }
                    if (data.locationRetryCount !== undefined) {
                        resultHtml += '<div class="update-result-item warning">';
                        resultHtml += '<div class="update-result-label">📍 位置重试次数：' + escapeHtml(data.locationRetryCount) + '</div>';
                        resultHtml += '</div>';
                    }
                    if (data.latencyFailedCount !== undefined) {
                        resultHtml += '<div class="update-result-item error">';
                        resultHtml += '<div class="update-result-label">❌ 延迟失败数量：' + escapeHtml(data.latencyFailedCount) + '</div>';
                        resultHtml += '</div>';
                    }
                    if (data.latencyRetryCount !== undefined) {
                        resultHtml += '<div class="update-result-item primary">';
                        resultHtml += '<div class="update-result-label">⚡ 延迟重试次数：' + escapeHtml(data.latencyRetryCount) + '</div>';
                        resultHtml += '</div>';
                    }
                    resultHtml += '</div>';
                    resultHtml += '</div>';
                    // 退避策略统计（如果有）
                    if (data.locationTotalDelay !== undefined || data.latencyTotalDelay !== undefined) {
                        resultHtml += '<h4 class="update-result-title">⏱️ 退避策略统计</h4>';
                        resultHtml += '<div class="update-result-grid">';
                        if (data.locationTotalDelay !== undefined) {
                            resultHtml += '<div class="update-result-item warning">';
                            resultHtml += '<div class="update-result-label">📍 位置总延迟：' + escapeHtml(data.locationTotalDelay) + 'ms</div>';
                            resultHtml += '</div>';
                        }
                        if (data.latencyTotalDelay !== undefined) {
                            resultHtml += '<div class="update-result-item primary">';
                            resultHtml += '<div class="update-result-label">⚡ 延迟总延迟：' + escapeHtml(data.latencyTotalDelay) + 'ms</div>';
                            resultHtml += '</div>';
                        }
                        resultHtml += '</div>';
                        // 退避配置详情（如果有）
                        //if (data.retryConfig) {
                        //    resultHtml += '<div style="margin-top: 12px; background: #faf5ff; padding: 12px; border-radius: 8px; border-left: 4px solid #10b981;">';
                        //    resultHtml += '<div style="font-size: 1.0rem; font-weight: 600; color: #059669; margin-bottom: 8px;">🔧 退避配置详情</div>';
                        //    resultHtml += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; font-size: 0.85rem; color: #6b7280;">';
                        //    resultHtml += '<div><strong style="color: #d97706;">初始延迟:</strong> <strong style="color: #059669;">' + escapeHtml(data.retryConfig.initialDelay) + 'ms</strong></div>';
                        //    resultHtml += '<div><strong style="color: #d97706;">最大延迟:</strong> <strong style="color: #059669;">' + escapeHtml(data.retryConfig.maxDelay) + 'ms</strong></div>';
                        //    resultHtml += '<div><strong style="color: #d97706;">退避因子:</strong> <strong style="color: #059669;">' + escapeHtml(data.retryConfig.backoffFactor) + 'x</strong></div>';
                        //    resultHtml += '<div><strong style="color: #d97706;">最大重试:</strong> <strong style="color: #059669;">' + escapeHtml(data.retryConfig.maxRetries) + '次</strong></div>';
                        //    resultHtml += '<div><strong style="color: #d97706;">抖动开关:</strong> <strong style="color: #059669;">' + (data.retryConfig.jitter ? '开启' : '关闭') + '</strong></div>';
                        //    resultHtml += '</div>';
                        //    resultHtml += '</div>';
                        //}
                    }
                    // 地址成功率统计（新增）- 三列布局
                    resultHtml += '<h4 class="update-result-title">📊 地址成功率统计</h4>';
                    resultHtml += '<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">';
                    if (data.addressSuccessRates) {
                        // IPv4 - 始终显示
                        resultHtml += '<div class="update-result-item info">';
                        resultHtml += '<div class="update-result-label" style="font-size: 0.9rem;">📍 IPv4 地址成功率</div>';
                        resultHtml += '<div style="font-size: 0.9rem; color: var(--text-secondary); font-weight: 600;">' + escapeHtml(data.addressSuccessRates.ipv4 || '本次未测试') + '</div>';
                        resultHtml += '</div>';
                        // IPv6 - 始终显示
                        resultHtml += '<div class="update-result-item success">';
                        resultHtml += '<div class="update-result-label" style="font-size: 0.9rem;">📍 IPv6 地址成功率</div>';
                        resultHtml += '<div style="font-size: 0.9rem; color: var(--text-secondary); font-weight: 600;">' + escapeHtml(data.addressSuccessRates.ipv6 || '本次未测试') + '</div>';
                        resultHtml += '</div>';
                        // 域名 - 始终显示
                        resultHtml += '<div class="update-result-item warning">';
                        resultHtml += '<div class="update-result-label" style="font-size: 0.9rem;">🌐 域名成功率</div>';
                        resultHtml += '<div style="font-size: 0.9rem; color: var(--text-secondary); font-weight: 600;">' + escapeHtml(data.addressSuccessRates.domain || '本次未测试') + '</div>';
                        resultHtml += '</div>';
                    } else {
                        resultHtml += '<div style="color: var(--text-secondary); padding: 8px; grid-column: 1 / -1;">暂无地址成功率数据</div>';
                    }
					resultHtml += '</div>';
                    // 有效结果统计（如果有）
                    if (data.validLocations !== undefined || data.validLatencies !== undefined) {
                        resultHtml += '<h4 class="update-result-title">✅ 有效结果</h4>';
                        resultHtml += '<div class="update-result-grid">';
                        if (data.validLocations !== undefined) {
                            resultHtml += '<div class="update-result-item success">';
                            resultHtml += '<div class="update-result-label">📍 有效位置：' + escapeHtml(data.validLocations) + '</div>';
                            resultHtml += '</div>';
                        }
                        if (data.validLatencies !== undefined) {
                            resultHtml += '<div class="update-result-item success">';
                            resultHtml += '<div class="update-result-label">⚡ 有效延迟：' + escapeHtml(data.validLatencies) + '</div>';
                            resultHtml += '</div>';
                        }
                        resultHtml += '</div>';
                    }
                    // 其他信息
                    resultHtml += '<div style="margin-top: 16px; padding: 12px; background: var(--bg-stat); border: 1px solid var(--border-primary); border-radius: 8px;">';
                    resultHtml += '<div style="font-size: 0.9rem; color: var(--text-secondary);">';
                    resultHtml += '<div>📅 历史键: <code style="background: var(--bg-secondary); padding: 2px 6px; border-radius: 4px; color: var(--text-primary);">' + escapeHtml(data.historyKey || '—') + '</code></div>';
                    resultHtml += '<div>🕐 时间: ' + new Date(data.timestamp).toLocaleString() + '</div>';
					resultHtml += '</div>';
                    resultHtml += '</div>';
                    result.className = 'result success';
                    result.innerHTML = resultHtml;
                } else {
                    result.className = 'result error';
                    result.innerHTML = '<h3>❌ 更新失败</h3><p>' + escapeHtml(data.error || '未知错误') + '</p>';
                }
                result.style.display = 'block';
                setTimeout(refreshData, 1500);
            } catch (error) {
                console.error('更新失败:', error);
                result.className = 'result error';
                result.innerHTML = '<h3>❌ 请求失败</h3><p>' + escapeHtml(error.message) + '</p>';
                result.style.display = 'block';
            } finally {
                btn.disabled = false;
                loading.style.display = 'none';
            }
        }
        async function setIpLimit() {
            const input = document.getElementById('ip-limit-input');
            const btn = document.getElementById('set-limit-btn');
            // 第一下点击 → 进入编辑模式
            if (!input.disabled) {
                const val = input.value.trim();
                const num = val === '' ? 0 : parseInt(val);
                if (isNaN(num) && val !== '') {
                    showMessage('请输入有效数字', 'error');
                    return;
                }
                btn.disabled = true;
                try {
                    const resp = await fetch('/set-limit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ limit: num || null })
                    });
                    const data = await resp.json();
                    if (data.success) {
                        if (num === 0 || val === '') {
                            input.value = '';
                            input.placeholder = '无限制（显示最新全部）';
                        } else {
                            input.value = num;
                        }
                        input.disabled = true;
                        input.style.color = '#a0a0a0';
                        input.style.backgroundColor = '#f0f0f0';
                        showMessage(data.message || '设置成功');
                        setTimeout(refreshData, 1200);
                    } else {
                        showMessage('设置失败', 'error');
                    }
                } catch (e) {
                    showMessage('请求失败', 'error');
                } finally {
                    btn.disabled = false;
                }
                return;
            }
            // 已禁用状态 → 点击激活编辑
            input.disabled = false;
            input.style.color = '';
            input.style.backgroundColor = '';
            input.placeholder = 'IP数量';
            input.focus();
        }
        function openSourcesModal() {
            const modal = document.getElementById('sources-modal');
            const textarea = document.getElementById('sources-textarea');
            if (!modal || !textarea) return;
            textarea.value = currentSourcesUrls.join('\\n');
            modal.style.display = 'flex';
        }
        function closeSourcesModal() {
            const modal = document.getElementById('sources-modal');
            if (modal) modal.style.display = 'none';
        }
        async function saveSources() {
            const textarea = document.getElementById('sources-textarea');
            if (!textarea) return;
            const sources = textarea.value.split('\\n').map(s => s.trim()).filter(s => s);
            try {
                const response = await fetch('/set-sources', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sources })
                });
                const data = await response.json();
                if (data.success) {
                    showMessage('来源设置成功');
                    closeSourcesModal();
                    await refreshData();
                } else {
                    showMessage('设置失败: ' + (data.error || '未知错误'), 'error');
                }
            } catch (error) {
                console.error('保存来源失败:', error);
                showMessage('设置失败: ' + error.message, 'error');
            }
        }
        function openBlacklistModal() {
            const modal = document.getElementById('blacklist-modal');
            const textarea = document.getElementById('blacklist-textarea');
            if (!modal || !textarea) return;
            textarea.value = currentBlacklist.join('\\n');
            modal.style.display = 'flex';
        }
        function closeBlacklistModal() {
            const modal = document.getElementById('blacklist-modal');
            if (modal) modal.style.display = 'none';
        }
        async function saveBlacklist() {
            const textarea = document.getElementById('blacklist-textarea');
            if (!textarea) return;
            const blacklist = textarea.value.split('\\n').map(s => s.trim()).filter(s => s);
            try {
                const response = await fetch('/set-blacklist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ blacklist })
                });
                const data = await response.json();
                if (data.success) {
                    showMessage('黑名单设置成功');
                    closeBlacklistModal();
                    await refreshData();
                } else {
                    showMessage('设置失败: ' + (data.error || '未知错误'), 'error');
                }
            } catch (error) {
                console.error('保存黑名单失败:', error);
                showMessage('设置失败: ' + error.message, 'error');
            }
        }
        async function refreshData() {
            try {
                const response = await fetch('/raw');
                const data = await response.json();
                // 更新状态面板
                const recentCountEl = document.getElementById('recent-count');
                const totalCountEl = document.getElementById('total-count');
                const lastTimeEl = document.getElementById('last-time');
                if (recentCountEl) recentCountEl.textContent = data.originalCount || 0;
                if (totalCountEl) totalCountEl.textContent = (data.totalUniqueIPs || 0).toLocaleString();
                if (lastTimeEl) lastTimeEl.textContent = data.lastUpdated ? new Date(data.lastUpdated).toLocaleTimeString() : '从未更新';
                // 更新IP列表
                const ipList = document.getElementById('ip-list');
                const displayIPs = data.ips || [];
                if (ipList) {
                    if (displayIPs.length > 0) {
                        ipList.innerHTML = displayIPs.map(function(item) {
                            // 确保 address 存在
                            const address = item?.address || 'unknown';
                            const safeId = simpleHash(address);
                            const location = item?.location || '未知';
                            let displayLocation = location;
                            const parsed = parseAddressWithPort(item?.address || 'unknown');
                            if (parsed.type !== 'domain' && (displayLocation === "未知" || displayLocation.toLowerCase() === 'ipv4' || displayLocation.toLowerCase() === 'ipv6')) {
                              displayLocation = parsed.type.toUpperCase();
                            }
                            const latency = item?.latency;
                            // 添加类型角标
                            let typeBadge = '';
    						if (parsed.type === 'ipv6') {
    							typeBadge = '<span style="background:#10b981; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">IPv6</span>';
    						} else if (parsed.type === 'ipv4') {
    							typeBadge = '<span style="background:#3b82f6; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">IPv4</span>';
    						} else if (parsed.type === 'domain') {
    							typeBadge = '<span style="background:#f59e0b; color:white; padding:2px 6px; border-radius:4px; font-size:0.8rem; margin-left:8px;">域名</span>';
    						}
    						// 格式化显示地址 - 只在端口不是443时显示端口
    						let displayAddress = parsed.address;
    						if (parsed.type === 'ipv6') {
    							displayAddress = '[' + displayAddress + ']'; 
    						}
    						if (parsed.port !== "443") {
    							displayAddress += ':' + parsed.port;
    						}
                            // 安全转义所有数据
                            const safeDisplayAddress = escapeHtml(displayAddress);
                            const safeDisplayLocation = escapeHtml(displayLocation);
                            return '<div class="ip-item" data-ip="' + escapeHtml(address) + '">\\
							<div class="ip-info">\\
								<span class="ip-address">' + safeDisplayAddress + '#' + safeDisplayLocation + (latency ? '_' + Math.round(latency) + 'ms' : '') + typeBadge + '</span>\\
								<span class="speed-result" id="speed-' + safeId + '">' + (latency ? Math.round(latency) + 'ms' : '-') + '</span>\\
							</div>\\
							<div class="action-buttons">\\
								<button class="small-btn" onclick="testSingleIP(\\\'' + escapeHtml(address).replace(/'/g, "\\\\'") + '\\\')" id="test-' + safeId + '">测速</button>\\
								<button class="small-btn" onclick="copyIP(\\\'' + escapeHtml(displayAddress).replace(/'/g, "\\\\'") + '\\\', \\\'' + escapeHtml(location).replace(/'/g, "\\\\'") + '\\\', ' + (latency || 'null') + ')">复制</button>\\
							</div>\\
							</div>';
					}).join('');
                        // 更新速度结果缓存 + 自动按延迟排序（修复核心）
                        speedResults = {}; // 重置
                        displayIPs.forEach(function(item) {
                            const address = item?.address;
                            const latency = item?.latency;
                            if (address) {
                                if (latency) {
                                    speedResults[address] = { latency: latency, success: true };
                                    const safeId = simpleHash(address);
                                    const el = document.getElementById('speed-' + safeId);
                                    if (el) {
                                        const cls = latency < 200 ? 'speed-fast' : latency < 500 ? 'speed-medium' : 'speed-slow';
                                        el.className = 'speed-result ' + cls;
                                        el.textContent = Math.round(latency) + 'ms';
                                    }
                                } else {
                                    speedResults[address] = { latency: Infinity, success: false };
                                }
                            }
                        });
                        // 关键：刷新页面或更新后自动按延迟从小到大排序
                        sortBySpeed();
                    } else {
                        ipList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 40px;">暂无 IP/域名 地址数据，请点击更新按钮获取</p>';
                    }
                }
                // 更新来源
                currentSourcesUrls = data.sources_urls || [];
                const sources = document.getElementById('sources');
                if (sources) {
                    const sourcesDisplay = [];
                    const sourceMap = new Map();
                    if (data.sources && data.sources.length > 0) {
                        data.sources.forEach(s => sourceMap.set(s.name, s));
                    }
                    currentSourcesUrls.forEach(url => {
                        let hostname = url;
                        try {
                            hostname = new URL(url).hostname;
                        } catch (e) {}
                        const existing = sourceMap.get(url);
                        if (existing) {
                            sourcesDisplay.push({ ...existing, name: hostname });
                        } else {
                            sourcesDisplay.push({ name: hostname, status: "pending", count: 0, message: "新增站点" });
                        }
                    });
                    if (sourcesDisplay.length > 0) {
                        sources.innerHTML = sourcesDisplay.map(function(s) {
                            const cls = s.status === 'success' ? '' : 'error';
                            const text = s.status === 'success' ? '成功获取 ' + (s.count || 0) + ' 个地址' :
                                         s.status === 'pending' ? s.message :
                                         '失败: ' + escapeHtml(s.error || '未知');
                            return '<div class="source ' + cls + '">\\
                                <strong>' + escapeHtml(s.name) + '</strong>: ' + text + '\\
                            </div>';
                        }).join('');
                    } else {
                        sources.innerHTML = '<p style="color: #64748b;">暂无数据来源信息</p>';
                    }
                }
                // 更新黑名单
                currentBlacklist = data.blacklist || [];
                // 更新路径
                currentPath = data.customPath || '';
                updateLinks();
                // 更新IP数量限制输入
                const input = document.getElementById('ip-limit-input');
                if (input) {
                    if (data.limit) {
                        input.value = data.limit;
                        input.disabled = true;
                        input.style.color = '#a0a0a0';
                        input.style.backgroundColor = '#f0f0f0';
                    } else {
                        input.value = '';
                        input.disabled = false;
                        input.style.color = '';
                        input.style.backgroundColor = '';
                        input.placeholder = '无限制（显示最新全部）';
                    }
                }
            } catch (e) {
                console.error('刷新数据失败:', e);
                showMessage('刷新数据失败: ' + e.message, 'error');
            }
        }
        document.addEventListener('DOMContentLoaded', function() {
            // 添加全局错误处理
            window.onerror = function(message, source, lineno, colno, error) {
                console.error('全局错误:', message, error);
                return true; // 阻止默认处理
            };
            // 防止未捕获的Promise拒绝
            window.onunhandledrejection = function(event) {
                console.error('未捕获的Promise拒绝:', event.reason);
                event.preventDefault();
            };
            updateLinks();
            refreshData();
            // 防止下拉菜单点击外部
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.admin-panel')) {
                    const dropdown = document.getElementById('admin-dropdown');
                    if (dropdown) dropdown.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>`;
  const headers = {
    "Content-Type": "text/html;charset=utf-8",
    "Access-Control-Allow-Origin": "*"
  };
  return new Response(html, { headers });
}
/* ====================== IPv6 地址规范化 ====================== */
// IPv6 地址规范化函数 - 只移除方括号，保持原始格式
function normalizeIPv6Address(ip) {
  if (!ip || typeof ip !== 'string') return ip;
  // 只移除方括号，保持地址原始格式（压缩或完整格式）
  return ip.replace(/[\[\]]/g, '');
}
/* ====================== /ip.txt 和 /ips ====================== */
async function handleGetIPs(env, attachment = false) {
  const limit = parseInt(await env.IP_STORAGE.get("ip_limit")) || null;
  const data = await getIPsWithFallback(env, limit);
  
  // 获取全局计数
  let totalUnique = await env.IP_STORAGE.get("global_unique_ips_count");
  if (!totalUnique) totalUnique = data.totalUniqueIPs;
  
  console.log(`handleGetIPs: totalUnique=${totalUnique}, currentBatch=${data.ips?.length}`);
  if (!data.ips || data.ips.length === 0) {
    return new Response("", {
      headers: {
        "Content-Type": "text/plain;charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    });
  }
  const txt = data.ips
    // 按延迟升序排序，没有延迟的排到最后
    .sort((a, b) => {
      if (a.latency && b.latency) return a.latency - b.latency;
      if (a.latency) return -1;
      if (b.latency) return 1;
      return 0;
    })
    .map(i => formatAddressOutput(i.address, i.location, i.latency))
    .join('\n');
  const headers = {
    "Content-Type": "text/plain;charset=utf-8",
    "Access-Control-Allow-Origin": "*"
  };
  if (attachment) {
    headers["Content-Disposition"] = "attachment; filename=cloudflare_ips.txt";
  }
  return new Response(txt + '\n', { headers });
}
/* ====================== 其余接口适配 ====================== */
async function handleRawIPs(env) {
  const latest = await getStoredIPsLatest(env);
  const limit = parseInt(await env.IP_STORAGE.get("ip_limit")) || null;
  const customPath = await getCustomPath(env);
  const display = await getIPsWithFallback(env, limit);
  const result = {
    ...latest,
    limit,
    customPath,
    sources_urls: await getSources(env),
    blacklist: display.blacklist,
    totalUniqueIPs: totalUnique, // 使用全局唯一地址总数
    ips: display.ips.sort((a, b) => {
      if (a.latency && b.latency) return a.latency - b.latency;
      if (a.latency) return -1;
      if (b.latency) return 1;
      return 0;
    }),
    count: display.count,
    originalCount: display.originalCount || 0,
  };
  return jsonResponse(result);
}
async function handleSpeedTest(req, env) {
  const url = new URL(req.url);
  const address = url.searchParams.get("ip");
  if (!address) return jsonResponse({ error: "missing ip" }, 400);
  let decodedAddress;
  try {
    decodedAddress = decodeURIComponent(address);
  } catch (e) {
    return jsonResponse({ error: "invalid ip encoding" }, 400);
  }
  const parsed = parseAddressWithPort(decodedAddress);
  // 形成 Cloudflare Resolver 的覆盖地址
  // IPv6 需要方括号包裹
  let formattedAddress = decodedAddress;
  if (parsed.type === 'ipv6' && !decodedAddress.startsWith('[')) {
    formattedAddress = `[${parsed.address}]:${parsed.port}`;
  }
  // 定义主备测速地址
  const primaryUrl = "https://speed.cloudflare.com/__down?bytes=50000";
  const backupUrl = "https://speed.cloudflare.com/__down?bytes=50000";
  const primaryHost = "speed.cloudflare.com";
  const backupHost = "speed.cloudflare.com";
  // 测速请求，先尝试主地址，失败后使用备用地址
  let latency = null;
  let latencySuccess = false;
  let usedBackup = false;
  // 第一次尝试：主地址
  try {
    const start = performance.now();
    const resp = await fetchWithRetry(
      primaryUrl,
      {
        method: "GET",
        headers: { Host: primaryHost },
        cf: { resolveOverride: formattedAddress }
      },
      3,
      1500
    );
    if (resp && resp.ok) {
      await resp.arrayBuffer();
      latency = Math.round(performance.now() - start);
      latencySuccess = true;
    }
  } catch (err) {
    // 主地址失败，标记为需要尝试备用地址
    latencySuccess = false;
  }
  // 如果主地址失败，使用备用地址重试
  if (!latencySuccess) {
    try {
      usedBackup = true;
      const start = performance.now();
      const resp = await fetchWithRetry(
        backupUrl,
        {
          method: "GET",
          headers: { Host: backupHost },
          cf: { resolveOverride: formattedAddress }
        },
        3,
        1500
      );
      if (resp && resp.ok) {
        await resp.arrayBuffer();
        latency = Math.round(performance.now() - start);
        latencySuccess = true;
      }
    } catch (err) {
      latency = null;
      latencySuccess = false;
    }
  }
  // 位置信息获取
  let location = "未知";
  try {
    if (parsed.type === 'ipv4') {
      // IPv4：ip-api
      const r = await fetchWithRetry(`http://ip-api.com/json/${parsed.address}?fields=countryCode`, {}, 2, 1000);
      if (r.ok) {
        const data = await r.json();
        if (data?.countryCode) location = data.countryCode;
      }
    } else if (parsed.type === 'ipv6') {
      // IPv6：ip-api（需要去除方括号）
      const normalizedIp = parsed.address.replace(/^\[|\]$/g, '');
      const r = await fetchWithRetry(`http://ip-api.com/json/${normalizedIp}?fields=countryCode`, {}, 2, 1000);
      if (r.ok) {
        const data = await r.json();
        if (data?.countryCode) location = data.countryCode + "_IPv6";
      }
    } else if (parsed.type === 'domain') {
      // 域名：DoH 解析 -> IPv4，再用 ipapi 获取国家/地区
      try {
        const doh = await fetchWithRetry(
          `https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(parsed.address)}&type=A`,
          { headers: { 'Accept': 'application/dns-json' } },
          2,
          200
        );
        if (doh.ok) {
          const dohData = await doh.json();
          const ipRecord = dohData?.Answer?.find(a => a.type === 1);
          if (ipRecord?.data) {
            const apiResp = await fetchWithRetry(`https://api.ipapi.is/?q=${encodeURIComponent(ipRecord.data)}`, {}, 2, 400);
            if (apiResp.ok) {
              const locationData = await apiResp.json();
              const countryCode = locationData?.location?.country_code;
              if (countryCode) location = parsed.address + "_" + countryCode;
            }
          }
        }
      } catch (e) {
        // DoH/定位失败时保持默认的 "未知"
      }
    }
  } catch (e) {
    // 捕获定位阶段的错误，但不影响主返回
  }
  return jsonResponse({
    success: latencySuccess,
    latency: latency,
    ip: decodedAddress,
    // 如果查询失败（location 是 "未知"），则返回域名本身，否则返回查询结果
    location: (parsed.type === 'domain' && location === "未知") ? parsed.address : (location || parsed.address)
  });
}
async function handleSaveLatency(req, env) { 
  return jsonResponse({success:true}); 
}
async function handleSetIpLimit(req, env) {
  const { limit } = await req.json();
  // 允许 null / 0 / 空 → 删除键，代表"无限制，显示最新全部"
  if (limit === null || limit === undefined || limit === 0 || limit === "") {
    await env.IP_STORAGE.delete("ip_limit");
    return jsonResponse({ success: true, message: "已取消数量限制，将显示最新批次全部IP" });
  }
  if (typeof limit !== 'number' || limit < 1 || !Number.isInteger(limit)) {
    return jsonResponse({ error: "limit 必须为正整数" }, 400);
  }
  await env.IP_STORAGE.put("ip_limit", limit.toString());
  return jsonResponse({ success: true, message: `已限制显示 ${limit} 条` });
}
function jsonResponse(data, status = 200) {
  return new Response(JSON.stringify(data, null, 2), {
    status,
    headers: { "Content-Type": "application/json", "Access-Control-Allow-Origin": "*" }
  });
}
function methodNotAllowed() {
  return jsonResponse({ error: "Method not allowed" }, 405);
}
function handleCORS() {
  return new Response(null, {
    headers: {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    }
  });
}
